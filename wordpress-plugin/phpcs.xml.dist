<?xml version="1.0"?>
<ruleset name="DC Tech Property Leads">
  <description>WordPress Coding Standards for the plugin sources (tests are excluded).</description>
  <file>dctech-property-leads.php</file>
  <file>includes</file>
  <arg name="extensions" value="php"/>
  <arg value="ps"/>

  <config name="minimum_wp_version" value="6.4"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="dctech-property-leads"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="DCTech"/>
        <element value="dctech"/>
      </property>
    </properties>
  </rule>
</ruleset>
