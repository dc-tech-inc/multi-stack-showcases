{
  "name": "dc-tech-inc/php-realestate-crm",
  "description": "Real-estate listings and a small lead/visit CRM: PHP 8 + MySQL, synthetic data.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": { "DcTech\\RealEstate\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "DcTech\\RealEstate\\Tests\\": "tests/" }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=256M",
    "test": "phpunit",
    "serve": "php -S 0.0.0.0:8080 -t public"
  },
  "config": { "sort-packages": true }
}
