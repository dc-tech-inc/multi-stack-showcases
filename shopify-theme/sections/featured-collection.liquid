{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="featured-collection">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="product-grid" role="list">
    {%- if collection != blank -%}
      {%- for product in collection.products limit: limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <li class="product-card product-card--placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
          <p>{{ 'sections.featured_collection.placeholder' | t }}</p>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
